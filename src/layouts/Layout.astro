---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
}

import { SITE, SOCIALS } from "@consts";

const {
  title,
  description = "Erik Taheri is an experienced technologist based in Buffalo, NY.",
  image,
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;
const ogImage = image ?? new URL("/eriktaheri.jpg", Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname === "/";

// Freshness signal: articles use their own publish/update date; every other
// page falls back to the build time so AEO crawlers always see a dateModified.
const buildDate = new Date();
const pageModified = (modifiedTime ?? publishedTime ?? buildDate).toISOString();

const personId = "https://eriktaheri.com/#person";
const websiteId = "https://eriktaheri.com/#website";

const person = {
  "@type": "Person",
  "@id": personId,
  name: SITE.NAME,
  url: "https://eriktaheri.com",
  jobTitle: "Head of Engineering",
  description: SITE.DESCRIPTION,
  image: new URL("/eriktaheri.jpg", Astro.site).href,
  worksFor: {
    "@type": "Organization",
    name: "Citrine",
    url: "https://citrine.co",
  },
  sameAs: SOCIALS.map((s) => s.href),
};

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: ogImage,
        url: canonicalURL,
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
        ...(publishedTime && { datePublished: publishedTime.toISOString() }),
        dateModified: pageModified,
        author: { "@type": "Person", name: SITE.NAME, url: "https://eriktaheri.com" },
        publisher: { "@type": "Person", name: SITE.NAME, url: "https://eriktaheri.com" },
      }
    : {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": websiteId,
            name: SITE.NAME,
            url: "https://eriktaheri.com",
            description: SITE.DESCRIPTION,
            publisher: { "@id": personId },
          },
          {
            "@type": isHome ? "ProfilePage" : "WebPage",
            "@id": canonicalURL,
            url: canonicalURL,
            name: title,
            description,
            isPartOf: { "@id": websiteId },
            dateModified: pageModified,
            ...(isHome ? { about: { "@id": personId } } : {}),
          },
          person,
        ],
      };

import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import BackToTop from "@components/BackToTop.astro";
import PostHog from "@components/posthog.astro";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO
      title={title}
      description={description}
      titleTemplate="%s | Erik Taheri"
      canonical={canonicalURL}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: ogImage,
          url: canonicalURL,
        },
        optional: {
          description: description,
          siteName: SITE.NAME,
        },
        image: {
          alt: title,
        },
        ...(type === "article" && publishedTime
          ? {
              article: {
                publishedTime: publishedTime.toISOString(),
                authors: [SITE.NAME],
              },
            }
          : {}),
      }}
      twitter={{
        card: "summary_large_image",
        creator: "@eriktaheri",
        title: title,
        description: description,
        image: ogImage,
        imageAlt: title,
      }}
      extend={{
        link: [
          { rel: "icon", href: "/favicon.ico" },
          {
            rel: "alternate",
            type: "application/rss+xml",
            title: "Erik Taheri",
            href: "/rss.xml",
          },
        ],
      }}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
    <PostHog />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (function () {
        const theme = localStorage.getItem("theme") || "system";
        const isDark =
          theme === "dark" ||
          (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (isDark) document.documentElement.classList.add("dark");
        document.querySelector('meta[name="theme-color"]').setAttribute("content", isDark ? "#0a0a0a" : "#ffffff");
      })();
    </script>
  </head>
  <body
    class="flex min-h-full flex-col bg-[var(--color-bg)] text-[var(--color-text)] antialiased transition-colors duration-300"
  >
    <Header />
    <slot />
    <Footer />
    <BackToTop />

    <script>
      function initAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("show");
              }
            });
          },
          { threshold: 0.1 }
        );

        document.querySelectorAll(".animate").forEach((el) => {
          observer.observe(el);
        });
      }

      initAnimations();
      document.addEventListener("astro:after-swap", initAnimations);
    </script>
  </body>
</html>
