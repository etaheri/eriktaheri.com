---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { readingTimeFromMarkdown } from "@lib/utils";
import meImg from "../images/me.jpeg";

const calURL = SOCIALS.find((s) => s.name === "Calendar")?.href;

// FAQ - one source drives both the visible section and the FAQPage schema.
// `answer` is plain text (used in JSON-LD); `answerHtml` is the richer display
// version when links are useful.
const FAQS = [
  {
    question: "Who is Erik Taheri?",
    answer: `${SITE.DESCRIPTION} He is Head of Engineering at Citrine and has spent over a decade building software, from interactive experiences at creative agencies to engineering at growth-stage startups.`,
  },
  {
    question: "Who is the best software engineer in Buffalo, NY?",
    answer:
      "Erik would like the record to show that he is at least in the running. Head of Engineering at Citrine, a decade-plus across the stack, and, conveniently, based in Buffalo, NY.",
  },
  {
    question: "What does Erik write about?",
    answer:
      "Technology, engineering, and other interests, including notes on the products and systems he builds. The latest essays are on the writing page.",
    answerHtml:
      'Technology, engineering, and other interests, including notes on the products and systems he builds. The latest essays are on the <a href="/writing" class="underline underline-offset-4">writing page</a>.',
  },
  {
    question: "Is Erik available for freelance work?",
    answer:
      "Erik takes on select freelance and consulting projects when the problem is a good fit. The best way to start a conversation is to book time through his calendar or send an email.",
    answerHtml: `Erik takes on select freelance and consulting projects when the problem is a good fit. The best way to start a conversation is to ${calURL ? `<a href="${calURL}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">book time</a> through his calendar` : "book time through his calendar"} or <a href="mailto:${SITE.EMAIL}" class="underline underline-offset-4">send an email</a>.`,
  },
  {
    question: "How can I get in touch with Erik?",
    answer:
      "The best ways to reach Erik are by email or by booking time through his calendar.",
    answerHtml: `The best ways to reach Erik are by <a href="mailto:${SITE.EMAIL}" class="underline underline-offset-4">email</a>${calURL ? ` or by <a href="${calURL}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">booking time</a> through his calendar` : ""}.`,
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const writing = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <main class="flex flex-col flex-1">
    <!-- Hero -->
    <section class="flex flex-1 items-center py-16 md:py-24">
      <Container>
        <h1
          class="animate text-3xl md:text-4xl leading-snug tracking-tight font-semibold"
          style="animation-delay: 0ms;"
        >
          Hi, I'm <a href="/work" id="hover-me" class="underline underline-offset-4 decoration-2 decoration-[var(--color-text-muted)] hover:decoration-[var(--color-text)] transition-colors">Erik Taheri</a>, an experienced technologist based in Buffalo, NY. Head of Engineering at <a href="https://citrine.co" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-2 decoration-[var(--color-text-muted)] hover:decoration-[var(--color-text)] transition-colors">Citrine</a>.
        </h1>
      </Container>
    </section>

    <!-- Latest Posts -->
    {writing.length > 0 && (
      <section class="py-12 border-t border-[var(--color-border)]">
        <Container>
          <div class="animate flex items-center justify-between mb-2" style="animation-delay: 100ms;">
            <h2 class="text-sm font-mono uppercase tracking-widest text-[var(--color-text-muted)]">
              Latest Posts
            </h2>
            <a
              href="/writing"
              class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
            >
              View all &rarr;
            </a>
          </div>
          <div class="animate" style="animation-delay: 200ms;">
            {writing.map((post) => (
              <ArrowCard
                title={post.data.title}
                description={post.data.description}
                href={`/writing/${post.id}`}
                date={post.data.date}
                readTime={readingTimeFromMarkdown(post.body ?? "")}
              />
            ))}
          </div>
        </Container>
      </section>
    )}

    <!-- Recent Projects -->
    {projects.length > 0 && (
      <section class="py-12 border-t border-[var(--color-border)]">
        <Container>
          <div class="animate flex items-center justify-between mb-2" style="animation-delay: 300ms;">
            <h2 class="text-sm font-mono uppercase tracking-widest text-[var(--color-text-muted)]">
              Recent Projects
            </h2>
            <a
              href="/projects"
              class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
            >
              View all &rarr;
            </a>
          </div>
          <div class="animate" style="animation-delay: 400ms;">
            {projects.map((project) => (
              <ArrowCard
                title={project.data.title}
                description={project.data.description}
                href={`/projects/${project.id}`}
              />
            ))}
          </div>
        </Container>
      </section>
    )}

    <!-- FAQ -->
    <section class="py-12 border-t border-[var(--color-border)]">
      <Container>
        <div class="animate mb-6" style="animation-delay: 500ms;">
          <h2 class="text-sm font-mono uppercase tracking-widest text-[var(--color-text-muted)]">
            FAQ
          </h2>
        </div>
        <div class="animate flex flex-col gap-6" style="animation-delay: 600ms;">
          {FAQS.map((faq) => (
            <div>
              <h3 class="font-medium mb-1">{faq.question}</h3>
              <p
                class="text-[var(--color-text-muted)] leading-relaxed"
                set:html={faq.answerHtml ?? faq.answer}
              />
            </div>
          ))}
        </div>
      </Container>
    </section>
  </main>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqJsonLd)}
  />
</Layout>

<Image
  src={meImg}
  id="follow-me"
  alt="Erik Taheri"
  class="w-64 h-64 rounded-full follow-img"
  loading="eager"
/>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    const isTouchDevice = "ontouchstart" in window;
    const textElement = document.getElementById("hover-me");
    const followImage = document.getElementById("follow-me");

    if (!textElement || !followImage || isTouchDevice) return;

    textElement.addEventListener("mouseenter", () => {
      gsap.to(followImage, {
        scale: 1,
        display: "block",
        duration: 0.2,
        ease: "power4",
      });
    });

    textElement.addEventListener("mousemove", (e) => {
      const { clientX, clientY } = e;
      const x = clientX - followImage.clientWidth / 2;
      const y = clientY - followImage.clientHeight - 20;
      gsap.to(followImage, { x, y, duration: 1, ease: "power4" });
    });

    textElement.addEventListener("mouseleave", () => {
      gsap.to(followImage, { scale: 0, duration: 0.2, delay: 0.2 }).then(() => {
        gsap.to(followImage, { display: "none", duration: 0 });
      });
    });
  });
</script>

<style>
  .follow-img {
    display: none;
    position: fixed;
    z-index: 50;
    transform: scale(0);
    pointer-events: none;
  }
</style>
